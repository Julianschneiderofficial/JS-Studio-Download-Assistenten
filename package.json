{
  "name": "js-studio-download-assistent",
  "version": "1.1.0",
  "private": true,
  "description": "Download-Assistent fuer JS Studio Firmenprogramme",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "de.jsstudio.downloadassistant",
    "productName": "JS Studio Download-Assistent",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Julianschneiderofficial",
        "repo": "JS-Studio-Download-Assistenten",
        "releaseType": "release"
      }
    ]
  }
}
